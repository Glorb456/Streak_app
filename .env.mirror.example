# Buddy mirror config. The OWNER of the mirrored data fills this in and hands
# it to the buddy, who saves it as .env.mirror next to docker-compose.mirror.yml
# (plus the owner's allowlist as mirror-emails.txt).
#
# Run with:
#   docker compose -f docker-compose.mirror.yml --env-file .env.mirror up -d --build

# Owner's sync token (the same SYNC_TOKEN the owner's own nodes use).
MIRROR_SYNC_TOKEN=

# Owner's host URL the mirror pulls from — their Funnel URL.
MIRROR_UPSTREAM=https://owner-machine.tailXXXX.ts.net

# How often to refresh the mirror, seconds. Deliberately slower than the
# owner's own backups; it is the last rung of the failover ladder.
MIRROR_INTERVAL=600

# The BUDDY's Funnel URL for this stack + /oauth2/callback. The owner must
# also add this URL to their Google OAuth client's authorized redirect URIs.
MIRROR_OAUTH_REDIRECT_URL=https://buddy-machine.tailXXXX.ts.net:8443/oauth2/callback

# Owner's Google OAuth client (same values as the owner's .env.oauth).
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=

# If the buddy's account running docker is not uid/gid 1000:
#NOTES_UID=1000
#NOTES_GID=1000
