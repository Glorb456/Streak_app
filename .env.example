# Copy to .env next to docker-compose.yml and fill in what applies.
# Everything here is optional: with none of it set the stack runs exactly as
# it always has (single node, no sync).

# Run the notes container as your user so the .md files stay editable on the
# host (only needed if you are not uid/gid 1000).
#NOTES_UID=1000
#NOTES_GID=1000

# This machine's public Funnel callback. Each node (host and every backup)
# has its own; find yours with `tailscale funnel status`.
#OAUTH_REDIRECT_URL=https://your-machine.tailXXXX.ts.net/oauth2/callback

# ----- sync -----
# host  = the hub other nodes sync with (your main computer)
# backup= your other computer; syncs with the host every SYNC_INTERVAL (30s)
# mirror= a buddy's machine holding YOUR data (use docker-compose.mirror.yml)
#SYNC_ROLE=host

# One long random secret shared by all of YOUR nodes (and given to a buddy
# who hosts your mirror). Generate with:  openssl rand -hex 32
#SYNC_TOKEN=

# backup only: where the host is. Tailnet IP is best (works even when the
# funnel is down):  http://100.x.y.z:3000   — or the host's Funnel URL.
#SYNC_UPSTREAM=

# Optional overrides
#SYNC_INTERVAL=30

# ----- encrypted buddy snapshots (host only, optional) -----
# Alternative/addition to a live mirror: push an AES-256-GCM encrypted
# snapshot of everything to a buddy who only ever stores ciphertext.
#BUDDY_BLOB_URL=https://buddy-machine.tailXXXX.ts.net
#BUDDY_BLOB_KEY=        # passphrase; KEEP THIS — without it blobs are noise
#BUDDY_BLOB_TOKEN=      # the buddy's SYNC_TOKEN (they must set one)
#BLOB_INTERVAL=21600
